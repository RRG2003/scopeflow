# Create a Payment Link, set its success/return URL to:
#   https://your-deployed-domain.com/studio?paid=1
# then paste the Payment Link URL below.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# Local/manual test unlock code. Visiting /studio?unlock=THIS_VALUE
